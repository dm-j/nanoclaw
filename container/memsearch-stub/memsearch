#!/bin/sh
# Relay memsearch CLI to the host services proxy.
# The proxy resolves agent identity from our container IP
# and scopes all operations to our agent group's memory directory.
#
# Passes both args and stdin (for commands like `memsearch summarize`
# which read input from stdin).

STDIN_DATA=""
if [ ! -t 0 ]; then
  STDIN_DATA=$(cat)
fi

AUTH_HEADER=()
if [ -n "${NANOCLAW_SERVICE_TOKEN:-}" ]; then
  AUTH_HEADER=(-H "Authorization: Bearer ${NANOCLAW_SERVICE_TOKEN}")
fi

exec curl -sf "http://memsearch.internal/cli" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  "${AUTH_HEADER[@]}" \
  --data-urlencode "args=$*" \
  --data-urlencode "stdin=$STDIN_DATA"
